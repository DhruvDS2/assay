# Copy to .env and fill in. Never commit .env (it is gitignored).
# `bench/__init__.py` loads .env into the environment on import, so every
# `python -m bench ...` run picks these up. An explicit shell `export` wins
# over the file.

# A1 — the real agent + LLM screenshot grader. Get one at
# https://console.anthropic.com. Install the extra: pip install -e ".[llm]"
ANTHROPIC_API_KEY=sk-ant-replace_me

# Solari sandbox/cloud browser (v1). One key covers browsers, sandboxes,
# and desktops. https://console.getsolari.com
SOLARI_API_KEY=slr_live_replace_me

# Session signing key for the shop. Set a fresh random value per run in v1,
# because Solari preview URLs are public.
GT_SECRET_KEY=change-me
